{
  "permissions": {
    "deny": [
      "Read(**/node_modules/**)",
      "Read(**/dist/**)",
      "Read(**/out/**)",
      "Read(**/release/**)",
      "Read(**/coverage/**)",
      "Read(**/test-results/**)",
      "Read(**/playwright-report/**)",
      "Read(**/*.tsbuildinfo)",
      "Read(**/*.log)",
      "Read(./pnpm-lock.yaml)",
      "Read(./packages/fixtures/raw/**)",
      "Read(./.data/**)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(./design/direzioni/**/screenshot/**)",
      "Read(**/e2e/screenshots/**)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo \"Control Center: prima di iniziare leggi docs/memoria/STATO.md e docs/memoria/PROSSIMI_PASSI.md (oppure usa la skill inizio-sessione). A fine lavoro usa la skill fine-sessione.\""
          }
        ]
      }
    ]
  }
}
