{
  "name": "@control-center/desktop",
  "version": "0.0.0",
  "private": true,
  "description": "Control Center desktop app (Electron main, preload and React renderer).",
  "author": "Control Center contributors",
  "license": "MIT",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "rebuild:native": "electron-builder install-app-deps",
    "typecheck": "tsc -p tsconfig.node.json && tsc -p tsconfig.web.json && tsc -p tsconfig.e2e.json",
    "e2e": "electron-vite build --mode e2e && playwright test --project=app",
    "package:dir": "electron-vite build && electron-builder --dir --config electron-builder.config.ts",
    "e2e:packaged": "pnpm package:dir && playwright test --project=packaged"
  },
  "dependencies": {
    "@vscode/tree-sitter-wasm": "0.3.1",
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "@control-center/app-log": "workspace:*",
    "@control-center/event-schema": "workspace:*",
    "@control-center/fixtures": "workspace:*",
    "@control-center/hooks-bridge": "workspace:*",
    "@control-center/ipc-contract": "workspace:*",
    "@control-center/project-model": "workspace:*",
    "@electron/fuses": "^2.1.3",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "6.0.0",
    "@xyflow/react": "^12.12.1",
    "cmdk": "^1.1.1",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "elkjs": "^0.12.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "10.1.0",
    "react-resizable-panels": "^4.24.1",
    "tailwindcss": "^4.3.5",
    "vite": "^8.3.8",
    "zod": "^4.6.7"
  }
}
