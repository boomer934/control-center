{
  "$description": "Control Center design tokens — direction 'precisione fluida' (phase 1c). Format: W3C Design Tokens (DTCG). Source of truth: design/sistema/tokens.css is generated from this file by scripts/build-tokens.mjs.",
  "color": {
    "$type": "color",
    "dark": {
      "page": { "$value": "#080808", "$description": "outside the window" },
      "bg-0": {
        "$value": "#0e0e0e",
        "$description": "chrome: activity bar, title bar, status bar"
      },
      "bg-1": { "$value": "#151515", "$description": "canvas: map, timeline, panels" },
      "bg-2": { "$value": "#1b1b1b", "$description": "side columns, docks, cells" },
      "bg-3": { "$value": "#262626", "$description": "hover, pressed, primary button fill" },
      "line": { "$value": "#2e2e2e", "$description": "hairlines between rows" },
      "line-2": { "$value": "#4a4a4a", "$description": "control borders" },
      "line-3": { "$value": "#6e6e6e", "$description": "strong borders, window edge" },
      "fg-1": { "$value": "#ebebeb" },
      "fg-2": { "$value": "#a3a3a3" },
      "fg-3": { "$value": "#858585", "$description": "placeholders and disabled text only" },
      "accent": { "$value": "#ebebeb", "$description": "focus ring, active tab, primary outline" },
      "on-accent": { "$value": "#0e0e0e" },
      "st-idle": { "$value": "#8f8f8f" },
      "st-reading": {
        "$value": "#7b9dff",
        "$description": "1c: moved from #6aaeff to keep distance from ag-local"
      },
      "st-writing": { "$value": "#ff9a4d" },
      "st-running": {
        "$value": "#8fd357",
        "$description": "1c: moved from #7fd36a toward yellow-green, away from ag-local"
      },
      "st-waiting": { "$value": "#ffd43b", "$description": "the only filled block on screen" },
      "st-waiting-edge": { "$value": "#ffd43b" },
      "st-waiting-text": { "$value": "#ffd43b" },
      "on-waiting": { "$value": "#141414" },
      "st-error": { "$value": "#ff6b6b" },
      "st-done": { "$value": "#b3b3b3" },
      "ag-claude": { "$value": "#c4a5ff" },
      "ag-sub": {
        "$value": "#c4a5ff",
        "$description": "same hue as Claude; told apart by glyph and sigil"
      },
      "ag-local": {
        "$value": "#5fd8f0",
        "$description": "1c: moved from #4fd6c8 toward cyan, away from st-running"
      },
      "diff-add-bg": { "$value": "#14281a" },
      "diff-add-fg": { "$value": "#a9e28f" },
      "diff-del-bg": { "$value": "#341618" },
      "diff-del-fg": { "$value": "#ffa3a3" },
      "scrim": { "$value": "#000000a6", "$description": "behind modal overlays" }
    },
    "light": {
      "page": { "$value": "#d4d4d4" },
      "bg-0": { "$value": "#e6e6e6" },
      "bg-1": { "$value": "#f4f4f4" },
      "bg-2": { "$value": "#ffffff" },
      "bg-3": { "$value": "#ececec" },
      "line": { "$value": "#dcdcdc" },
      "line-2": { "$value": "#b5b5b5" },
      "line-3": { "$value": "#7a7a7a" },
      "fg-1": { "$value": "#141414" },
      "fg-2": { "$value": "#575757" },
      "fg-3": { "$value": "#6e6e6e" },
      "accent": { "$value": "#141414" },
      "on-accent": { "$value": "#ffffff" },
      "st-idle": { "$value": "#636363" },
      "st-reading": { "$value": "#2a5bd7", "$description": "1c: moved from #1b62c9" },
      "st-writing": { "$value": "#a64a05" },
      "st-running": { "$value": "#336e0b", "$description": "1c: moved from #2c7520" },
      "st-waiting": {
        "$value": "#141414",
        "$description": "light theme: dark plate with yellow text"
      },
      "st-waiting-edge": { "$value": "#141414" },
      "st-waiting-text": { "$value": "#7a5a00" },
      "on-waiting": { "$value": "#ffd43b" },
      "st-error": { "$value": "#c4272a" },
      "st-done": { "$value": "#474747" },
      "ag-claude": { "$value": "#6a3fd1" },
      "ag-sub": { "$value": "#6a3fd1" },
      "ag-local": { "$value": "#006d87", "$description": "1c: moved from #00736a" },
      "diff-add-bg": { "$value": "#e2f2da" },
      "diff-add-fg": { "$value": "#24560a" },
      "diff-del-bg": { "$value": "#fbe2e2" },
      "diff-del-fg": { "$value": "#a3191c" },
      "scrim": { "$value": "#14141447" }
    }
  },
  "shadow": {
    "$type": "shadow",
    "$description": "Only for overlays (palette, dialogs, toasts). Panels never cast shadows.",
    "dark": {
      "overlay": { "$value": "0 12px 32px #0000009e, 0 2px 6px #00000066" }
    },
    "light": {
      "overlay": { "$value": "0 12px 32px #0000002e, 0 2px 6px #00000014" }
    }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "sans": {
        "$value": ["Instrument Sans", "Segoe UI", "system-ui", "sans-serif"],
        "$description": "chrome: tabs, toolbars, buttons, agent names, state words, headings"
      },
      "mono": {
        "$value": ["Martian Mono", "Cascadia Mono", "Consolas", "ui-monospace", "monospace"],
        "$description": "data: paths, numbers, commands, diffs"
      }
    },
    "stretch": {
      "$type": "string",
      "mono-wide": { "$value": "87.5%", "$description": "readouts and commands" },
      "mono-narrow": { "$value": "87.5%", "$description": "metadata" },
      "mono-cell": { "$value": "75%", "$description": "map cells only" },
      "sans": { "$value": "100%" }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": { "$value": 400 },
      "medium": { "$value": 500 },
      "semibold": { "$value": 600 }
    },
    "leading": {
      "$type": "number",
      "tight": { "$value": 1.15, "$description": "big numbers" },
      "base": { "$value": 1.35, "$description": "UI" },
      "prose": { "$value": 1.45, "$description": "chat messages" }
    }
  },
  "density": {
    "$description": "compact is the default (user choice, 1b). No functional text below 11px.",
    "compact": {
      "fs-xs": {
        "$type": "dimension",
        "$value": "11px",
        "$description": "minimum size for any functional text"
      },
      "fs-s": { "$type": "dimension", "$value": "11.5px" },
      "fs-map": { "$type": "dimension", "$value": "11px" },
      "fs-m": { "$type": "dimension", "$value": "12.5px" },
      "fs-l": { "$type": "dimension", "$value": "13.5px" },
      "fs-xl": {
        "$type": "dimension",
        "$value": "16px",
        "$description": "telemetry numbers, dialog titles; never larger than the wait"
      },
      "row": { "$type": "dimension", "$value": "20px" },
      "row-gap": { "$type": "dimension", "$value": "2px" },
      "lane": {
        "$type": "dimension",
        "$value": "34px",
        "$description": "timeline lane; grows by lane-split per parallel call row"
      },
      "pad-x": { "$type": "dimension", "$value": "{space.4}" },
      "pad-y": { "$type": "dimension", "$value": "{space.2}" },
      "gap": { "$type": "dimension", "$value": "{space.3}" },
      "card-pad": { "$type": "dimension", "$value": "{space.4}" }
    },
    "comfortable": {
      "fs-xs": { "$type": "dimension", "$value": "11.5px" },
      "fs-s": { "$type": "dimension", "$value": "12px" },
      "fs-map": { "$type": "dimension", "$value": "11.5px" },
      "fs-m": { "$type": "dimension", "$value": "13.5px" },
      "fs-l": { "$type": "dimension", "$value": "14.5px" },
      "fs-xl": { "$type": "dimension", "$value": "17px" },
      "row": { "$type": "dimension", "$value": "24px" },
      "row-gap": { "$type": "dimension", "$value": "3px" },
      "lane": { "$type": "dimension", "$value": "40px" },
      "pad-x": { "$type": "dimension", "$value": "{space.5}" },
      "pad-y": { "$type": "dimension", "$value": "{space.3}" },
      "gap": { "$type": "dimension", "$value": "{space.4}" },
      "card-pad": { "$type": "dimension", "$value": "{space.5}" }
    }
  },
  "space": {
    "$type": "dimension",
    "$description": "Spacing scale, steps of 2 then 4. Use these for every margin, padding and gap.",
    "0": { "$value": "0px" },
    "1": { "$value": "2px" },
    "2": { "$value": "4px" },
    "3": { "$value": "6px" },
    "4": { "$value": "8px" },
    "5": { "$value": "12px" },
    "6": { "$value": "16px" },
    "7": { "$value": "20px" },
    "8": { "$value": "24px" },
    "9": { "$value": "32px" },
    "10": { "$value": "48px" }
  },
  "radius": {
    "$type": "dimension",
    "$description": "Never above 10px except pills: past that the tool becomes a generic dashboard.",
    "0": { "$value": "0px" },
    "1": { "$value": "4px", "$description": "kbd, badges, sigils" },
    "2": { "$value": "6px", "$description": "map cells, buttons, inner tables" },
    "3": { "$value": "10px", "$description": "cards, containers, dialogs, inputs" },
    "pill": { "$value": "999px", "$description": "agent chips, state tags, waiting segment" }
  },
  "size": {
    "$type": "dimension",
    "hair": { "$value": "1px", "$description": "hairline borders" },
    "stroke": { "$value": "2px", "$description": "writing border, primary outline, focus ring" },
    "edge": {
      "$value": "3px",
      "$description": "state edge on cards, active marker in the activity bar"
    },
    "bar": { "$value": "4px", "$description": "telemetry bars" },
    "dot": { "$value": "6px" },
    "glyph-s": { "$value": "10px" },
    "glyph": { "$value": "12px", "$description": "state and agent glyphs" },
    "icon": { "$value": "16px" },
    "icon-l": { "$value": "18px", "$description": "activity bar" },
    "sigil": { "$value": "16px", "$description": "channel sigil height" },
    "ctl-s": { "$value": "20px", "$description": "toolbar icon buttons" },
    "ctl": { "$value": "24px", "$description": "buttons" },
    "ctl-l": { "$value": "30px", "$description": "dialog buttons, inputs on one line" },
    "tab": { "$value": "28px", "$description": "tab strips and dock headers" },
    "cell-sign": { "$value": "18px", "$description": "state column inside a map cell" }
  },
  "layout": {
    "$type": "dimension",
    "win-w": { "$value": "1440px", "$description": "reference window for mockups" },
    "win-h": { "$value": "900px" },
    "act-w": { "$value": "48px" },
    "title-h": { "$value": "32px" },
    "status-h": { "$value": "24px" },
    "tb-h": { "$value": "30px", "$description": "section toolbar" },
    "btab-h": { "$value": "22px", "$description": "closed bottom dock strip" },
    "bdock-h": { "$value": "260px", "$description": "open bottom dock" },
    "dock-w": { "$value": "344px" },
    "agents-w": { "$value": "288px" },
    "palette-w": { "$value": "640px" },
    "dialog-w": { "$value": "560px" },
    "toast-w": { "$value": "360px" }
  },
  "motion": {
    "duration": {
      "$type": "duration",
      "1": { "$value": "150ms", "$description": "hover, press, color changes" },
      "2": { "$value": "200ms", "$description": "state changes on nodes and cards" },
      "3": { "$value": "300ms", "$description": "overlays in, reading pulse, done trail" }
    },
    "easing": {
      "$type": "cubicBezier",
      "out": { "$value": [0.22, 1, 0.36, 1] },
      "in": { "$value": [0.4, 0, 1, 1] },
      "io": { "$value": [0.65, 0, 0.35, 1] }
    },
    "cycle": {
      "$type": "duration",
      "$description": "Repeating or one-shot state cues. Only 'breathe' loops forever, and only on the waiting segment of the status bar.",
      "breathe": {
        "$value": "1600ms",
        "$description": "waiting segment cursor: 100% → 25% → 100%, ease-io, infinite"
      },
      "running": {
        "$value": "1200ms",
        "$description": "indeterminate progress sweep, linear; static stripes with reduced motion"
      },
      "pulse-reading": {
        "$value": "300ms",
        "$description": "one pulse per read event, never looped"
      },
      "trail-done": { "$value": "300ms", "$description": "writing color fades to done once" },
      "trail-delay": { "$value": "400ms", "$description": "hold before the done trail starts" }
    }
  }
}
