{
  "name": "control-center",
  "version": "0.0.0",
  "private": true,
  "description": "Local AI Control Center: a visual desktop app to watch and orchestrate AI coding agents (Claude Code + local Ollama models) and your local dev infrastructure.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "pnpm -r --if-present build",
    "e2e": "pnpm --filter @control-center/desktop e2e",
    "e2e:packaged": "pnpm --filter @control-center/desktop e2e:packaged",
    "dev": "pnpm --filter @control-center/desktop dev",
    "verify": "pnpm format:check && pnpm typecheck && pnpm lint && pnpm test",
    "prepare": "simple-git-hooks"
  },
  "simple-git-hooks": {
    "pre-commit": "npx --no-install lint-staged && node scripts/gitleaks-staged.mjs",
    "commit-msg": "npx --no-install commitlint --edit \"$1\""
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "eslint-plugin-security": "^4.2.1",
    "globals": "^17.14.0",
    "lint-staged": "^17.6.0",
    "prettier": "^3.10.1",
    "simple-git-hooks": "^2.14.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  }
}
