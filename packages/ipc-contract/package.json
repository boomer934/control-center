{
  "name": "@control-center/ipc-contract",
  "version": "0.0.0",
  "private": true,
  "description": "The only IPC surface of the desktop app: explicit channels with zod request/response schemas, a sender-checked main-side registrar and the typed preload API.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./main": "./src/main.ts",
    "./preload": "./src/preload.ts",
    "./workspace": "./src/workspace.ts",
    "./terminal": "./src/terminal.ts",
    "./agent-config": "./src/agent-config.ts",
    "./capabilities": "./src/capabilities.ts",
    "./claude": "./src/claude.ts",
    "./codex": "./src/codex.ts",
    "./project": "./src/project.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@control-center/event-schema": "workspace:*",
    "@control-center/project-model": "workspace:*",
    "zod": "^4.6.7"
  }
}
